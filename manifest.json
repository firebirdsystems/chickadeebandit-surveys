{
  "id": "surveys",
  "name": "Surveys",
  "version": "1.0.0",
  "description": "Multi-question surveys for household decisions, trip planning, and org feedback. Adults create; everyone responds. Results revealed when the survey closes.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "general",
  "tags": [
    "surveys",
    "feedback",
    "decisions",
    "communication",
    "everyone"
  ],
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "contexts": ["household", "shared_space", "shared_space.roster"],
  "storage": "db",
  "row_policies": {
    "surveys": {
      "kind": "adult_writable",
      "steward_writes_only": true,
      "retain_days": {
        "default": 730,
        "timestamp_column": "created_at",
        "override_key": "survey_history",
        "dependent_tables": [
          { "table": "questions", "foreign_key": "survey_id" },
          { "table": "responses", "foreign_key": "survey_id" },
          { "table": "response_receipts", "foreign_key": "survey_id" }
        ]
      },
      "frozen_when": {
        "status_column": "status",
        "locked_values": ["closed"]
      },
      "column_write_acls": {
        "anonymous": { "writable_by": [], "actions": ["update"] }
      }
    },
    "questions": {
      "kind": "adult_writable",
      "steward_writes_only": true
    },
    "responses": {
      "kind": "endpoint_only",
      "read": "none"
    },
    "response_receipts": {
      "kind": "owner_only",
      "member_column": "member_id",
      "adults_bypass": false,
      "member_can_update": false,
      "endpoint_writes_only": true
    }
  },
  "anonymous_responses": {
    "receipt_table": "response_receipts",
    "session_column": "survey_id",
    "member_column": "member_id",
    "created_at_column": "created_at",
    "response_table": "responses",
    "response_session_column": "survey_id",
    "response_question_column": "question_id",
    "response_member_column": "member_id",
    "response_answer_column": "answer",
    "response_id_column": "id",
    "response_created_at_column": "created_at",
    "session_table": "surveys",
    "session_id_column": "id",
    "session_status_column": "status",
    "session_open_value": "open",
    "session_anonymous_column": "anonymous",
    "session_deadline_column": "closes_at",
    "result_visible_values": ["closed"],
    "question_table": "questions",
    "question_session_column": "survey_id",
    "question_id_column": "id"
  },
  "member_references": {
    "surveys": { "column": "created_by", "on_removed": "keep" },
    "responses": { "column": "member_id", "on_removed": "delete" },
    "response_receipts": { "column": "member_id", "on_removed": "delete", "id_column": "rowid" }
  },
  "publishes": [
    "survey.created",
    "survey.closed"
  ],
  "publish_acls": {
    "survey.created": { "require_role": "adult" },
    "survey.closed":  { "require_role": "adult" }
  },
  "alert_on": [
    "survey.created",
    "survey.closed"
  ],
  "agenda": {
    "kind": "reminder",
    "label": "Surveys",
    "source": {
      "kind": "sql",
      "query": "SELECT s.id AS id, s.title AS title, s.closes_at AS when_at FROM app_surveys__surveys s LEFT JOIN app_surveys__response_receipts r ON r.survey_id = s.id WHERE s.status = 'open' AND substr(s.closes_at, 1, 10) = :today AND r.member_id IS NULL LIMIT 10"
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_surveys__surveys s LEFT JOIN app_surveys__response_receipts r ON r.survey_id = s.id WHERE s.status = 'open' AND r.member_id IS NULL LIMIT 1"
    },
    "display": {
      "template": "badge",
      "count": "n",
      "label": "surveys waiting for you",
      "severity": "info"
    }
  },
  "nav": { "label": "Surveys" },
  "widget": { "label": "Surveys", "size": "small" },
  "resource_limits": {
    "max_db_bytes": 104857600
  },
  "icon": "📋",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["open_surveys", "closed_surveys"]
  }
}
